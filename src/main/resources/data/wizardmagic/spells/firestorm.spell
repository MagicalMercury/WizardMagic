# spell v1 name="火焰风暴"
# 行为语言版龙卷：形状只管出生位置，每一步的力全在这里。
# 调参入口：rel 的 0.73 = 释放起点，28 = 爆开加速度，8 = 约束强度，3.5 = 切向角速度。

on cast {
    emit {
        element: fire
        count: 8192
        life: 240
        shape: helix { radius: 4.8, thickness: 0.35, height: 12, turns: 1.2,
                       length: 1.2, amplitude: 2.2, frequency: 1.0,
                       radiusPulse: 0.18, radiusWave: 2.0, radiusSpeed: 2.5 }
        at: aim(6)
    }
}

on tick(dt) {
    let rel  = smoothstep(0.73, 1.0, time / life)
    let hold = 8.0 * (1 - rel)
    let spin = 3.5 * (1 - 0.75 * rel)
    let burst = 28.0 * rel
    let damp = max(0, 1 - 0.05 * dt)
    let vol  = volatility(fire)
    let g    = gravity(fire)

    for p in particles {
        let d  = len_xz(p.pos - p.axis)
        let t  = tangent(p.axis, p.pos)
        let rd = radial(p.axis, p.pos)
        let blend = 1 - exp(-3 * dt)

        if (d > 0.0001) {
            let vt = dot(p.v, t)
            let vr = dot(p.v, rd)
            vt = vt + (spin * d - vt) * blend
            let aR = -vt * vt / d + burst
            if (hold > 0 and p.targetR > 0) {
                aR = aR - hold * (d - p.targetR) - 2 * sqrt(hold) * vr
            }
            vr = vr + aR * dt
            p.v = t * vt + rd * vr
        }

        p.v = p.v * damp
        p.v = p.v + vec(0, -g * 9.8 * dt, 0)
        p.v = p.v + vec(0, -hold * (p.pos.y - p.anchor.y) * dt, 0)
        p.v = p.v + vec(0, 1.2 * dt, 0)
        p.v = p.v + vec(
            noise(p.pos.x * 0.5, p.pos.y * 0.5, p.pos.z * 0.5, step * 3),
            noise(p.pos.x * 0.5, p.pos.y * 0.5, p.pos.z * 0.5, step * 3 + 1),
            noise(p.pos.x * 0.5, p.pos.y * 0.5, p.pos.z * 0.5, step * 3 + 2)
        ) * (vol * dt)

        p.pos = p.pos + p.v * dt
    }
}

on touch {
    hurt(0, 2.0)
}