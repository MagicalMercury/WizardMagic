{
  "multipart": [
    {
      "when": {
        "active": "false"
      },
      "apply": {
        "model": "wizardmagic:block/crucible/creative_crucible"
      }
    },
    {
      "when": {
        "active": "true"
      },
      "apply": {
        "model": "wizardmagic:block/crucible/creative_crucible_active"
      }
    }
  ]
}
